{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/require_pre_pr_review.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
